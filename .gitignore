# Python 缓存与编译文件
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.venv/
venv/
env/

# 环境变量与密钥
.env
.env.*
!.env.example

# 测试、覆盖率、类型检查缓存
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE / 编辑器
.vscode/
.idea/

# 操作系统文件
.DS_Store
Thumbs.db

# 本地日志与临时文件
*.log
tmp/
temp/

# 本地数据库备份或导出文件
*.sql
*.dump
*.backup

# Android 安装包
*.apk
